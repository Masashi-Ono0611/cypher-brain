{
  "name": "cypher-brain",
  "version": "0.0.1",
  "type": "module",
  "description": "Encrypt a gbrain snapshot so only the key holder can read it (age X25519). Produces one backend-agnostic ciphertext for censorship-resistant storage.",
  "keywords": [
    "age",
    "encryption",
    "backup",
    "arweave",
    "ton",
    "ton-storage",
    "mcp",
    "second-brain",
    "permanent-storage",
    "snapshot",
    "x25519",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Masashi-Ono0611/cypher-brain.git"
  },
  "homepage": "https://github.com/Masashi-Ono0611/cypher-brain#readme",
  "bugs": {
    "url": "https://github.com/Masashi-Ono0611/cypher-brain/issues"
  },
  "author": "Masashi Ono (https://github.com/Masashi-Ono0611)",
  "files": [
    "dist"
  ],
  "bin": {
    "cypher-brain": "dist/cli.mjs",
    "cypher-brain-mcp": "dist/mcp.mjs",
    "cipher-brain": "dist/cli.mjs",
    "cipher-brain-mcp": "dist/mcp.mjs"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status --since=origin/main",
    "format": "biome format --write .",
    "check:help-docs": "node scripts/check-help-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "selftest": "bash scripts/selftest.sh",
    "selftest:profiles": "bash scripts/selftest-profiles.sh",
    "selftest:cypherbrainignore": "bash scripts/selftest-cypherbrainignore.sh",
    "selftest:interop": "bash scripts/selftest-interop.sh",
    "selftest:storage": "bash scripts/selftest-storage.sh",
    "selftest:rclone": "bash scripts/selftest-rclone.sh",
    "selftest:ton": "bash scripts/selftest-ton.sh",
    "selftest:ton-provider": "bash scripts/selftest-ton-provider.sh",
    "selftest:ton-dns": "bash scripts/selftest-ton-dns.sh",
    "dogfood:ton": "node scripts/ton-dogfood.mjs",
    "experiment:ton-provider": "node scripts/ton-provider-experiment.mjs",
    "selftest:recovery": "bash scripts/selftest-recovery.sh",
    "selftest:recovery-kit": "bash scripts/selftest-recovery-kit.sh",
    "selftest:restore-security": "bash scripts/selftest-restore-security.sh",
    "selftest:pq": "bash scripts/selftest-pq.sh",
    "selftest:minisign": "bash scripts/selftest-minisign.sh",
    "selftest:push-partial-failure": "bash scripts/selftest-push-partial-failure.sh",
    "selftest:idempotency-lib": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-idempotency-lib.mjs",
    "selftest:verify-levels": "bash scripts/selftest-verify-levels.sh",
    "selftest:schedule": "bash scripts/selftest-schedule.sh",
    "selftest:init": "bash scripts/selftest-init.sh",
    "selftest:gbrain-pglite": "bash scripts/selftest-gbrain-pglite.sh",
    "selftest:help-docs": "bash scripts/selftest-help-docs.sh",
    "selftest:arweave": "node scripts/arweave-roundtrip.mjs",
    "selftest:arweave-nodeps": "node scripts/selftest-arweave-nodeps.mjs",
    "selftest:usd-rate": "node scripts/selftest-usd-rate.mjs",
    "selftest:wallet-balance": "node scripts/selftest-wallet-balance.mjs",
    "selftest:sdk-advice": "node scripts/selftest-sdk-advice.mjs",
    "selftest:turbo-dep": "node scripts/selftest-turbo-dep.mjs",
    "selftest:error-codes": "node scripts/selftest-error-codes.mjs",
    "selftest:progress": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-progress.mjs",
    "selftest:push-balance-report": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-push-balance-report.mjs",
    "selftest:config-file": "bash scripts/selftest-config-file.sh",
    "selftest:doctor": "bash scripts/selftest-doctor.sh",
    "selftest:properties": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-properties.mjs",
    "selftest:cctv-age": "node scripts/selftest-cctv-age.mjs",
    "selftest:plan": "bash scripts/selftest-plan.sh",
    "selftest:receipt": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-receipt.mjs",
    "selftest:audit": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-audit.mjs",
    "selftest:otel": "node scripts/selftest-otel.mjs",
    "mutation-test": "stryker run",
    "verify:suite": "npm run build && npm run typecheck && npm run lint && npm run check:help-docs && npm run selftest && npm run selftest:profiles && npm run selftest:cypherbrainignore && npm run selftest:interop && npm run selftest:storage && npm run selftest:rclone && npm run selftest:ton && npm run selftest:ton-provider && npm run selftest:ton-dns && npm run selftest:recovery && npm run selftest:recovery-kit && npm run selftest:restore-security && npm run selftest:pq && npm run selftest:minisign && npm run selftest:push-partial-failure && npm run selftest:idempotency-lib && npm run selftest:verify-levels && npm run selftest:schedule && npm run selftest:config-file && npm run selftest:init && npm run selftest:gbrain-pglite && npm run selftest:help-docs && npm run selftest:arweave && npm run selftest:arweave-nodeps && npm run selftest:usd-rate && npm run selftest:wallet-balance && npm run selftest:sdk-advice && npm run selftest:turbo-dep && npm run selftest:error-codes && npm run selftest:progress && npm run selftest:push-balance-report && npm run selftest:doctor && npm run selftest:properties && npm run selftest:cctv-age && npm run selftest:plan && npm run selftest:receipt && npm run selftest:audit && npm run selftest:otel && bash scripts/cli-smoke.sh && node scripts/mcp-smoke.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "arweave": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "arweave": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@ardrive/turbo-sdk": "^1.42.0",
    "@ton/crypto": "^3.2.0",
    "@ton/ton": "^16.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.1.0",
    "arlocal": "^1.1.66",
    "arweave": "^1.15.7",
    "cctv-age": "0.2.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "age-encryption": "^0.3.0",
    "ignore": "^7.0.6"
  }
}
